# SecureText System Configuration

# Environment
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Authentication Secrets
JWT_SECRET=securetext_mtech_jwt_secret_dev_32bytes_min_key_random!
JWT_EXPIRES_IN=24h

# Database Configuration
# For local SQLite zero-config development:
DB_TYPE=sqlite
SQLITE_DB_PATH=./data/securetext.db

# For PostgreSQL / Supabase cloud deployment:
# DB_TYPE=postgres
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Security Parameters
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
MAX_CIPHERTEXT_SIZE_BYTES=1048576

# Demo Accounts Auto-Seed (true/false)
SEED_DEMO_ACCOUNTS=true
